{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>scottlz0310/renovate-config//presets/default",
    "github>scottlz0310/renovate-config//presets/languages/nodejs",
    "github>scottlz0310/renovate-config//presets/languages/rust",
    "github>scottlz0310/renovate-config//presets/languages/typescript",
    "github>scottlz0310/renovate-config//presets/package-managers/bun",
    "github>scottlz0310/renovate-config//presets/tools/biome",
    "github>scottlz0310/renovate-config//presets/tools/lefthook",
    "github>scottlz0310/renovate-config//presets/options/automerge",
    "github>scottlz0310/renovate-config//presets/options/schedule",
    "github>scottlz0310/renovate-config//presets/options/security"
  ],
  "packageRules": [
    {
      "description": "Bun本体は他の依存と束ねず、MSIX生成とWACKを確認してから手動でマージする。両者をCIへ載せたら削除する（design-decisions.md 4.4）",
      "matchManagers": ["bun-version"],
      "groupName": "Bun runtime",
      "automerge": false
    },
    {
      "description": "webview2-com / windows-core / muda は Tauri（wry）が解決する版に一致させる必要がある（src-tauri/Cargo.toml のコメント）。単独で上げると crate が二重にリンクされ、with_webview が返す controller とイベントハンドラの型が別物になってコンパイルが通らない。Tauri の更新に追従してのみ上げるため、Dependency Dashboard での承認制にする",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["webview2-com", "windows-core", "muda"],
      "groupName": "Tauri native crates (follow tauri)",
      "dependencyDashboardApproval": true,
      "automerge": false
    }
  ]
}
