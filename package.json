    "@types/bun": "^1.4.2",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "hast-util-sanitize": "^5.0.2",
