{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "メインウィンドウへ付与する最小権限。core:default は使わず、必要な core 権限だけを列挙する",
  "windows": ["main"],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:webview:default",
    "core:window:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "http://*" }, { "url": "https://*" }]
    }
  ]
}
